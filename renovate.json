{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>Rheinwerk/molecule"
  ],
  "customDatasources": {
    "mozilla-tls-ciphers": {
      "description": "Mozilla server side TLS intermediate profile, the TLS 1.2 cipher list is carried as the digest",
      "defaultRegistryUrlTemplate": "https://ssl-config.mozilla.org/guidelines/latest.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $formatNumber(version, \"0.0#\"), \"digest\": $join(configurations.intermediate.ciphers.openssl, \":\")}]}"
      ]
    },
    "mozilla-tls-ciphersuites": {
      "description": "Mozilla server side TLS intermediate profile, the TLS 1.3 ciphersuites are carried as the digest",
      "defaultRegistryUrlTemplate": "https://ssl-config.mozilla.org/guidelines/latest.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $formatNumber(version, \"0.0#\"), \"digest\": $join(configurations.intermediate.ciphersuites, \":\")}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Cipher strings in defaults/main.yml annotated with a renovate comment",
      "managerFilePatterns": [
        "/^defaults/main\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) version=(?<currentValue>\\S+)\\s+\\w+: \"(?<currentDigest>[^\"]+)\""
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "description": "Cipher changes need a human review, one pull request for both lists",
      "matchDatasources": [
        "custom.mozilla-tls-ciphers",
        "custom.mozilla-tls-ciphersuites"
      ],
      "groupName": "mozilla tls guidelines",
      "automerge": false
    }
  ]
}
